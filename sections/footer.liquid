
<style>
  .myntra-footer-container {
    background: #fafbfc;
    border-top: 1px solid #eaeaec;
    padding: 50px 0 30px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #282c3f;
  }
  .myntra-footer-grid {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 30px;
    display: grid;
    grid-template-columns: 240px 240px 320px 1fr;
    gap: 40px;
  }
  @media (max-width: 1024px) {
    .myntra-footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .myntra-footer-grid {
      grid-template-columns: 1fr;
    }
  }
  .myntra-col-title {
    font-size: 0.82rem;
    font-weight: 800;
    color: #282c3f;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
  }
  .myntra-footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .myntra-footer-links a {
    color: #696e79;
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
    transition: color 0.15s;
  }
  .myntra-footer-links a:hover {
    color: #282c3f;
    font-weight: 600;
  }
  .myntra-app-badges {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .myntra-app-badge-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #000000;
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .myntra-social-row {
    display: flex;
    gap: 14px;
    font-size: 1.25rem;
    margin-top: 10px;
  }
  .myntra-social-row a {
    color: #696e79;
    text-decoration: none;
    transition: color 0.2s;
  }
  .myntra-social-row a:hover {
    color: #ff3f6c;
  }
  .myntra-guarantee-box {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
  }
  .myntra-guarantee-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px dashed #ff3f6c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: #ff3f6c;
    flex-shrink: 0;
  }
  .myntra-guarantee-text b {
    display: block;
    color: #282c3f;
    font-size: 0.92rem;
    margin-bottom: 4px;
  }
  .myntra-guarantee-text span {
    font-size: 0.85rem;
    color: #696e79;
    line-height: 1.4;
    display: block;
  }
  .myntra-footer-copyright {
    max-width: 1440px;
    margin: 40px auto 0;
    padding: 24px 30px 0;
    border-top: 1px solid #eaeaec;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 0.85rem;
    color: #94969f;
  }
</style>

