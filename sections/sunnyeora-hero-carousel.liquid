<script>
  (function() {
    var track = document.getElementById('syCarouselTrack');
    var viewport = document.getElementById('syCarouselViewport');
    var prevBtn = document.getElementById('syPrevBtn');
    var nextBtn = document.getElementById('syNextBtn');
    var dots = document.querySelectorAll('#syCarouselDots .sy-dot');
    var progressBar = document.getElementById('syProgressBar');
    
    if (!track || !viewport) return;

    var currentIndex = 0;
    var totalSlides = 4;
    var slideDuration = 5500; // 5.5 seconds per slide
    var progressInterval = null;
    var slideTimeout = null;
    var progressStartTime = 0;
    var isPaused = false;
    var touchStartX = 0;
    var touchEndX = 0;

    function goToSlide(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;
      
      track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
      
      dots.forEach(function(dot, i) {
        if (i === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });

      startProgress();
    }

    function startProgress() {
      clearInterval(progressInterval);
      clearTimeout(slideTimeout);
      if (progressBar) progressBar.style.width = '0%';
      progressStartTime = Date.now();

      progressInterval = setInterval(function() {
        if (!isPaused) {
          var elapsed = Date.now() - progressStartTime;
          var percent = Math.min((elapsed / slideDuration) * 100, 100);
          if (progressBar) progressBar.style.width = percent + '%';
          if (elapsed >= slideDuration) {
            clearInterval(progressInterval);
            goToSlide(currentIndex + 1);
          }
        } else {
          progressStartTime += 50;
        }
      }, 50);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function(e) {
        e.preventDefault();
        goToSlide(currentIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function(e) {
        e.preventDefault();
        goToSlide(currentIndex + 1);
      });
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var idx = parseInt(this.getAttribute('data-index'), 10);
        goToSlide(idx);
      });
    });

    viewport.addEventListener('mouseenter', function() {
      isPaused = true;
    });
    viewport.addEventListener('mouseleave', function() {
      isPaused = false;
    });

    viewport.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
      isPaused = true;
    }, { passive: true });

    viewport.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      isPaused = false;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      var diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 45) {
        if (diff > 0) {
          goToSlide(currentIndex + 1);
        } else {
          goToSlide(currentIndex - 1);
        }
      }
    }

    window.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') {
        goToSlide(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        goToSlide(currentIndex + 1);
      }
    });

    startProgress();
  })();
</script>

