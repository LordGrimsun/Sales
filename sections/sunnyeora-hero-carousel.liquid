<style>
  .sy-carousel-section {
    width: 100%;
    margin-bottom: 35px;
    background: #FAF9F5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    position: relative;
    user-select: none;
  }
  .sy-carousel-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 10px 20px 0;
    position: relative;
  }
  .sy-carousel-viewport {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.18);
  }
  .sy-carousel-track {
    display: flex;
    transition: transform 0.55s cubic-bezier(0.25, 1, 0.5, 1);
    width: 100%;
  }
  .sy-slide {
    min-width: 100%;
    box-sizing: border-box;
    padding: 55px 65px;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    position: relative;
  }
  @media (max-width: 990px) {
    .sy-slide {
      flex-direction: column;
      padding: 40px 24px 50px;
      gap: 30px;
      text-align: center;
    }
  }

  /* Distinctive luxury backgrounds for each slide */
  .sy-slide-1 {
    background: linear-gradient(135deg, #052317 0%, #0D5C3A 55%, #144931 100%);
  }
  .sy-slide-2 {
    background: linear-gradient(135deg, #300817 0%, #681533 55%, #3B0E20 100%);
  }
  .sy-slide-3 {
    background: linear-gradient(135deg, #081B33 0%, #154378 55%, #0B2547 100%);
  }
  .sy-slide-4 {
    background: linear-gradient(135deg, #18181B 0%, #27272A 55%, #18181B 100%);
  }

  /* Content Column */
  .sy-slide-content {
    flex: 1;
    max-width: 650px;
    z-index: 2;
  }
  .sy-slide-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 18px;
    border-radius: 30px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 18px;
    backdrop-filter: blur(8px);
  }
  .sy-tag-green {
    background: rgba(52, 211, 153, 0.18);
    color: #6EE7B7;
    border: 1px solid rgba(52, 211, 153, 0.35);
  }
  .sy-tag-rose {
    background: rgba(244, 114, 182, 0.18);
    color: #FBCFE8;
    border: 1px solid rgba(244, 114, 182, 0.35);
  }
  .sy-tag-blue {
    background: rgba(96, 165, 250, 0.18);
    color: #BAE6FD;
    border: 1px solid rgba(96, 165, 250, 0.35);
  }
  .sy-tag-gold {
    background: rgba(251, 191, 36, 0.18);
    color: #FDE68A;
    border: 1px solid rgba(251, 191, 36, 0.35);
  }

  .sy-slide-title {
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 900;
    line-height: 1.12;
    margin: 0 0 16px;
    color: #ffffff;
    letter-spacing: -0.5px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.25);
  }
  .sy-slide-desc {
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.6;
    margin-bottom: 24px;
    font-weight: 400;
  }

  /* Price highlight inside slide */
  .sy-slide-price-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }
  @media (max-width: 990px) {
