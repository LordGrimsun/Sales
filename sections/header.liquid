
<style>
  .myntra-header-wrapper {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #ffffff;
    box-shadow: 0 4px 12px 0 rgba(0, 0, 0, 0.05);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #282c3f;
  }
  .myntra-header-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }
  .myntra-logo-area {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .myntra-logo-badge {
    width: 46px;
    height: 38px;
    background: linear-gradient(135deg, #ff3f6c 0%, #ff905a 50%, #ff2459 100%);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-weight: 900;
    font-size: 1.4rem;
    letter-spacing: -1px;
    box-shadow: 0 4px 10px rgba(255, 63, 108, 0.35);
  }
  .myntra-logo-text {
    font-weight: 900;
    font-size: 1.35rem;
    color: #282c3f;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .myntra-nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 80px;
  }
  .myntra-nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }
  .myntra-nav-link {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 16px;
    font-size: 0.88rem;
    font-weight: 700;
    color: #282c3f;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    border-bottom: 4px solid transparent;
    transition: border-color 0.2s, color 0.2s;
  }
  .myntra-nav-item:hover > .myntra-nav-link {
    color: #ff3f6c;
    border-bottom-color: #ff3f6c;
  }
  .myntra-studio-badge {
    color: #ff3f6c;
    font-size: 0.65rem;
    font-weight: 800;
    vertical-align: super;
    margin-left: 2px;
  }
  /* Mega Menu Dropdown */
  .myntra-mega-menu {
    position: absolute;
    top: 80px;
    left: 0;
    background: #ffffff;
    box-shadow: 0 15px 30px rgba(0,0,0,0.12);
    display: none;
    padding: 24px 32px;
    width: 960px;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    z-index: 999;
  }
  .myntra-nav-item:hover .myntra-mega-menu {
    display: grid;
  }
  .myntra-mega-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .myntra-mega-block-title {
    font-size: 0.85rem;
    font-weight: 800;
    color: #ff3f6c;
    text-transform: uppercase;
    margin-bottom: 8px;
    letter-spacing: 0.3px;
  }
  .myntra-mega-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .myntra-mega-links a {
    text-decoration: none;
    color: #282c3f;
    font-size: 0.82rem;
    line-height: 1.4;
    transition: color 0.15s;
  }
  .myntra-mega-links a:hover {
    color: #ff3f6c;
    font-weight: 600;
  }
  /* Search Bar */
  .myntra-search-bar {
    flex: 1;
    max-width: 500px;
    position: relative;
    display: flex;
    align-items: center;
  }
  .myntra-search-input {
    width: 100%;
    height: 42px;
    background: #f5f5f6;
    border: 1px solid #f5f5f6;
    border-radius: 4px;
    padding: 0 16px 0 42px;
    font-size: 0.88rem;
    color: #696e79;
    outline: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .myntra-search-input:focus {
    background: #ffffff;
    border-color: #d4d5d9;
    color: #282c3f;
  }
  .myntra-search-icon {
    position: absolute;
    left: 14px;
    color: #696e79;
    font-size: 1rem;
    pointer-events: none;
  }
  /* Action Icons */
  .myntra-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .myntra-action-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #282c3f;
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 700;
    gap: 4px;
  }
  .myntra-nav-svg {
    stroke: #282c3f;
    transition: stroke 0.2s, transform 0.2s;
    display: block;
  }
  .myntra-action-btn:hover .myntra-nav-svg {
    stroke: #ff3f6c;
    transform: translateY(-1px);
  }
  .myntra-bag-icon-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
  }
  .myntra-bag-count {
    position: absolute;
    top: -6px;
    right: -10px;
    background: #ff3f6c;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(255, 63, 108, 0.4);
    line-height: 1;
  }
  /* Profile Dropdown */
  .myntra-profile-wrapper {
    position: relative;
  }
  .myntra-profile-dropdown {
    position: absolute;
    top: 50px;
    right: -30px;
    width: 280px;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    border-radius: 4px;
    padding: 20px;
    display: none;
    z-index: 1000;
  }
  .myntra-profile-wrapper:hover .myntra-profile-dropdown {
    display: block;
  }
  .myntra-profile-title {
    font-weight: 800;
    font-size: 0.95rem;
    color: #282c3f;
  }
  .myntra-profile-subtitle {
    font-size: 0.8rem;
    color: #696e79;
    margin: 4px 0 16px;
  }
  .myntra-login-btn {
    display: block;
    width: 100%;
    padding: 10px;
    text-align: center;
    border: 1px solid #ff3f6c;
    color: #ff3f6c;
    font-weight: 800;
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }
  .myntra-login-btn:hover {
    background: #ff3f6c;
    color: #ffffff;
  }
  .myntra-profile-divider {
    height: 1px;
    background: #eaeaec;
    margin: 14px 0;
  }
  .myntra-profile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    color: #282c3f;
    text-decoration: none;
    font-size: 0.85rem;
  }
  .myntra-profile-link:hover {
    font-weight: 700;
    color: #ff3f6c;
  }
</style>

