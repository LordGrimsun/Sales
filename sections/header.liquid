<script id="catalog-search-submit-script">
document.addEventListener("DOMContentLoaded", function() {
  const searchInput = document.querySelector(".myntra-search-input");
  const searchSvg = document.querySelector(".myntra-search-svg");
  function doSearch() {
    if (!searchInput) return;
    const q = searchInput.value.trim();
    if (q) window.location.href = "/collections/all?q=" + encodeURIComponent(q);
    else window.location.href = "/collections/all";
  }
  if (searchInput) {
    searchInput.addEventListener("keydown", function(e) {
      if (e.key === "Enter") { e.preventDefault(); doSearch(); }
    });
  }
  if (searchSvg) {
    searchSvg.style.cursor = "pointer";
    searchSvg.addEventListener("click", doSearch);
  }
});
</script>

