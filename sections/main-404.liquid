<style>
  .sy-404-container {
    max-width: 800px;
    margin: 80px auto;
    padding: 40px 24px;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .sy-404-badge {
    display: inline-block;
    background: #FEE2E2;
    color: #DC2626;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 18px;
    letter-spacing: 0.5px;
  }
  .sy-404-code {
    font-size: 5rem;
    font-weight: 900;
    color: #1E293B;
    line-height: 1;
    margin: 0 0 16px;
    letter-spacing: -2px;
  }
  .sy-404-heading {
    font-size: 1.8rem;
    font-weight: 800;
    color: #334155;
    margin: 0 0 12px;
  }
  .sy-404-desc {
    font-size: 1.05rem;
    color: #64748B;
    max-width: 520px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }
  .sy-404-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .sy-btn-primary {
    background: #0D5C3A;
    color: #ffffff;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 30px;
    font-weight: 800;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 15px rgba(13,92,58,0.25);
    transition: background 0.2s, transform 0.15s;
  }
  .sy-btn-primary:hover {
    background: #092B1C;
    transform: translateY(-2px);
  }
  .sy-btn-secondary {
    background: #ffffff;
    border: 1.5px solid #CBD5E1;
    color: #1E293B;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 30px;
    font-weight: 800;
    font-size: 0.95rem;
    transition: all 0.2s;
  }
  .sy-btn-secondary:hover {
    border-color: #1E293B;
  }
</style>

<div class="sy-404-container">
  <span class="sy-404-badge">ERROR 404</span>
  <div class="sy-404-code">404</div>
  <h1 class="sy-404-heading">Page Not Found</h1>
  <p class="sy-404-desc">
    The page or product you're looking for doesn't exist, may have been removed, or is temporarily unavailable.
  </p>
  <div class="sy-404-actions">
    <a href="/collections/all" class="sy-btn-primary">
      <span>EXPLORE ALL PRODUCTS</span>
      <span>➔</span>
    </a>
    <a href="/" class="sy-btn-secondary">
      Back to Home
    </a>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
