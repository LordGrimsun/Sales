<style>
  .sy-catalog-section {
    max-width: 1400px;
    margin: 40px auto;
    padding: 0 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .sy-catalog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid #E2E8F0;
  }
  .sy-catalog-title {
    font-size: 1.8rem;
    font-weight: 900;
    margin: 0;
    color: #1E293B;
  }
  .sy-catalog-subtitle {
    font-size: 0.88rem;
    color: #64748B;
    margin-top: 4px;
  }
  .sy-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  .sy-card-wrap {
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .sy-card-wrap:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
  }
  .sy-card-img-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: #F8FAFC;
    overflow: hidden;
  }
  .sy-card-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .sy-card-wrap:hover .sy-card-img-box img {
    transform: scale(1.05);
  }
  .sy-discount-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #0D5C3A;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 0.3px;
    box-shadow: 0 2px 8px rgba(13,92,58,0.3);
  }
  .sy-heart-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: transform 0.2s, background 0.2s;
  }
  .sy-heart-btn:hover {
    transform: scale(1.15);
    background: #ffffff;
  }
  .sy-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .sy-brand-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: #0D5C3A;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .sy-prod-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1E293B;
    margin: 0 0 6px 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sy-price-block {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: auto;
    margin-bottom: 16px;
  }
  .sy-curr-price {
    font-size: 1.35rem;
    font-weight: 900;
    color: #1E293B;
  }
  .sy-mrp-price {
    font-size: 0.95rem;
    color: #94A3B8;
    text-decoration: line-through;
  }
  .sy-buy-btn {
    width: 100%;
    background: #0D5C3A;
    color: #ffffff;
    border: none;
    padding: 13px;
    border-radius: 30px;
    font-weight: 800;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 12px rgba(13,92,58,0.25);
    transition: background 0.2s, transform 0.15s;
  }
  .sy-buy-btn:hover {
    background: #092B1C;
    transform: translateY(-2px);
  }
</style>

<div class="sy-catalog-section" id="catalog">
  <div class="sy-catalog-header">
    <div>
      <h2 class="sy-catalog-title">Trending In Store</h2>
      <div class="sy-catalog-subtitle">Verified Store Inventory &bull; Express Shipping</div>
    </div>
    <a href="/collections/all" style="color: #0D5C3A; font-weight: 800; text-decoration: none; font-size: 0.95rem;">
      VIEW ALL ({{ collections['all'].products.size }}) ➔
    </a>
  </div>

  <div class="sy-catalog-grid">
    {% for product in collections['all'].products offset: 4 limit: 12 %}
      <div class="sy-card-wrap">
        <a href="{{ product.url }}" style="text-decoration:none; color:inherit; display:block;">
          <div class="sy-card-img-box">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
            {% else %}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #f1f5f9; color: #94a3b8;">No Image</div>
            {% endif %}
            {% if product.compare_at_price > product.price %}
              {% assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
              <span class="sy-discount-badge">-{{ discount_pct }}% OFF</span>
            {% endif %}
            <button class="sy-heart-btn" onclick="event.preventDefault(); event.stopPropagation(); window.toggleWishlist && window.toggleWishlist('{{ product.handle }}', this);" title="Save to Wishlist" aria-label="Save to Wishlist">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#282c3f" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>
          <div class="sy-card-body">
            <div class="sy-brand-tag">{{ product.vendor | default: 'SUNNYEORA' }}</div>
            <h3 class="sy-prod-title" title="{{ product.title | escape }}">{{ product.title }}</h3>
            <div class="sy-price-block">
              <span class="sy-curr-price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="sy-mrp-price">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </a>
        <div style="padding: 0 16px 16px 16px;">
          <button class="sy-buy-btn" onclick="event.preventDefault(); if(window.openCartDrawer) { window.openCartDrawer('{{ product.title | escape }}', '{{ product.price | money_without_currency }}', '{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 }}{% endif %}'); }">
            ADD TO BAG
          </button>
        </div>
      </div>
    {% else %}
      <p style="color: #64748b; grid-column: 1 / -1; text-align: center;">No additional products at this time.</p>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trending Catalog Grid",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Trending Catalog Grid"
    }
  ]
}
{% endschema %}
