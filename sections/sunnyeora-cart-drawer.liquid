
<style>
  #syCartOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    z-index: 999998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  #syCartOverlay.open {
    opacity: 1;
    visibility: visible;
  }

  #syCartDrawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100vh;
    background: #ffffff;
    box-shadow: -5px 0 30px rgba(0, 0, 0, 0.18);
    z-index: 999999;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  #syCartDrawer.open {
    transform: translateX(0);
  }

  .sy-drawer-header {
    padding: 20px 24px;
    border-bottom: 1px solid #eaeaec;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
  }
  .sy-drawer-title-box {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sy-drawer-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: #282c3f;
  }
  .sy-drawer-badge {
    background: #0D5C3A;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 12px;
  }
  .sy-drawer-close-btn {
    background: none;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    color: #696e79;
    line-height: 1;
    padding: 4px;
    transition: color 0.2s;
  }
  .sy-drawer-close-btn:hover {
    color: #ff3f6c;
  }

  .sy-progress-strip {
    padding: 12px 24px;
    background: #E8F3EE;
    border-bottom: 1px solid #D1E7DD;
    font-size: 0.82rem;
    font-weight: 700;
    color: #0D5C3A;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sy-items-container {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sy-item-card {
    display: flex;
    gap: 14px;
    padding: 14px;
    background: #FAF9F5;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
  }
  .sy-item-icon {
    font-size: 2rem;
    background: #ffffff;
    border-radius: 10px;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #E2E8F0;
    flex-shrink: 0;
  }
  .sy-item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .sy-item-name {
    font-weight: 800;
    font-size: 0.9rem;
    color: #1E293B;
    line-height: 1.3;
  }
  .sy-item-meta {
    font-size: 0.78rem;
    color: #64748B;
    margin-top: 2px;
  }
  .sy-qty-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
  }
  .sy-qty-ctrl {
    display: flex;
    align-items: center;
    border: 1px solid #CBD5E1;
    background: #ffffff;
    border-radius: 6px;
    overflow: hidden;
  }
  .sy-qty-btn {
    border: none;
    background: none;
    font-size: 0.9rem;
    cursor: pointer;
    font-weight: 700;
    padding: 3px 10px;
    color: #1E293B;
  }
  .sy-qty-val {
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0 6px;
    color: #1E293B;
  }
  .sy-item-price {
    font-weight: 900;
    font-size: 1rem;
    color: #0D5C3A;
  }

  .sy-drawer-footer {
    padding: 20px 24px;
    border-top: 1px solid #eaeaec;
    background: #ffffff;
  }
  .sy-cost-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 0.88rem;
    color: #64748B;
  }
  .sy-checkout-btn {
    display: block;
    width: 100%;
    border-radius: 30px;
    padding: 16px;
    font-size: 0.95rem;
    font-weight: 900;
    text-align: center;
    color: #ffffff;
    text-decoration: none;
    background: #0D5C3A;
    box-shadow: 0 4px 15px rgba(13, 92, 58, 0.25);
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    margin-top: 14px;
  }
  .sy-checkout-btn:hover {
    background: #092B1C;
    transform: translateY(-2px);
  }
</style>

<div id="syCartOverlay" onclick="window.closeCartDrawer()"></div>

<div id="syCartDrawer">
  <!-- Header -->
  <div class="sy-drawer-header">
    <div class="sy-drawer-title-box">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0D5C3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <h3 class="sy-drawer-title">Your Shopping Bag</h3>
      <span id="syCartBadgeCount" class="sy-drawer-badge">1 ITEM</span>
    </div>
    <button class="sy-drawer-close-btn" onclick="window.closeCartDrawer()">✕</button>
  </div>

  <!-- Free Shipping Notification -->
  <div class="sy-progress-strip">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0D5C3A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle;"><polyline points="20 6 9 17 4 12"></polyline></svg>
    <span>You unlocked <b>FREE USPS Air Express Shipping</b> (US & UK)!</span>
  </div>

  <!-- Items List -->
  <div class="sy-items-container" id="syCartItemList">
    <div class="sy-item-card">
      <div class="sy-item-icon" id="syCartItemIcon"><img src="https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?auto=format&fit=crop&w=120&q=80" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;"></div>
      <div class="sy-item-info">
        <div class="sy-item-name" id="syCartItemTitle">Sunnyeora Deep-Sleep™ Cervical Pillow</div>
        <div class="sy-item-meta">Color: Ice-Silk White | Size: Universal</div>
        <div class="sy-qty-row">
          <div class="sy-qty-ctrl">
            <button class="sy-qty-btn" onclick="modifyQty(-1)">-</button>
            <span class="sy-qty-val" id="syCartItemQty">1</span>
            <button class="sy-qty-btn" onclick="modifyQty(1)">+</button>
          </div>
          <div class="sy-item-price" id="syCartItemPrice">$49.99</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Summary & Checkout Footer -->
  <div class="sy-drawer-footer">
    <div class="sy-cost-row">
      <span>Subtotal</span>
      <span id="syCartSubtotal" style="font-weight: 800; color: #1E293B;">$49.99</span>
    </div>
    <div class="sy-cost-row">
      <span>Shipping (USPS Air)</span>
      <span style="font-weight: 800; color: #0D5C3A;">FREE</span>
    </div>

    <a href="/checkout" class="sy-checkout-btn">
      PROCEED TO SECURE CHECKOUT ➔
    </a>

    <div style="display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 14px; font-size: 0.72rem; color: #64748B;">
      <span style="display: flex; align-items: center; gap: 4px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        SSL 256-Bit
      </span>
      <span style="display: flex; align-items: center; gap: 4px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        Stripe & Visa
      </span>
      <span style="display: flex; align-items: center; gap: 4px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.07 1.71-.93 2.73 1.01.08 2.02-.48 2.63-1.23z"/></svg>
        Apple Pay
      </span>
    </div>
  </div>
</div>

<script>
  window.openCartDrawer = function(title, price, icon) {
    if (title) {
      const tEl = document.getElementById('syCartItemTitle');
      const pEl = document.getElementById('syCartItemPrice');
      const iEl = document.getElementById('syCartItemIcon');
      const sub = document.getElementById('syCartSubtotal');
      if (tEl) tEl.textContent = title;
      if (pEl) pEl.textContent = '$' + price;
      if (iEl && icon) iEl.textContent = icon;
      if (sub) sub.textContent = '$' + price;
    }
    const d = document.getElementById('syCartDrawer');
    const o = document.getElementById('syCartOverlay');
    if (d) d.classList.add('open');
    if (o) o.classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  window.closeCartDrawer = function() {
    const d = document.getElementById('syCartDrawer');
    const o = document.getElementById('syCartOverlay');
    if (d) d.classList.remove('open');
    if (o) o.classList.remove('open');
    document.body.style.overflow = '';
  };

  function modifyQty(change) {
    const qEl = document.getElementById('syCartItemQty');
    if (qEl) {
      let q = parseInt(qEl.textContent) || 1;
      q += change;
      if (q < 1) q = 1;
      qEl.textContent = q;
    }
  }

  // Connect click listeners to all ADD TO BAG buttons across the site
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.myntra-add-bag-btn, .sy-trigger-cart').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const card = btn.closest('.myntra-product-card');
        if (card) {
          const title = card.querySelector('.myntra-product-title')?.textContent?.trim();
          const priceStr = card.querySelector('.myntra-current-price')?.textContent?.replace('$', '')?.trim();
          window.openCartDrawer(title, priceStr);
        } else {
          window.openCartDrawer();
        }
      });
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        window.closeCartDrawer();
      }
    });
  });
</script>

