<div class="sunnyeora-categories-grid page-width" style="max-width: 1400px; margin: 40px auto; padding: 0 20px;">
  <div style="text-align: center; margin-bottom: 30px;">
    <h2 style="font-size: 2rem; font-weight: 900; color: #1E293B; margin-bottom: 8px; letter-spacing: 0.5px;">CATEGORIES TO BAG</h2>
    <p style="color: #64748B; font-size: 1.05rem;">Explore curated fashion, dresses, knits, suits and everyday essentials.</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
    <a href="/collections/all?q=dress" style="text-decoration: none; position: relative; border-radius: 20px; overflow: hidden; height: 300px; box-shadow: 0 8px 25px rgba(0,0,0,0.06); display: block;">
      <img src="https://images.unsplash.com/photo-1595777457583-95e059d581b8?auto=format&fit=crop&w=600&q=80" alt="Dresses & Gowns" style="width: 100%; height: 100%; object-fit: cover;">
      <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85), transparent 60%); padding: 24px; display: flex; flex-direction: column; justify-content: flex-end; color: #fff;">
        <span style="background: #ff3f6c; color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 0.75rem; font-weight: 800; width: fit-content; margin-bottom: 8px;">TRENDING</span>
        <h3 style="font-size: 1.4rem; font-weight: 900; margin: 0; color: #fff;">Dresses & Gowns</h3>
        <p style="font-size: 0.85rem; color: #E2E8F0; margin: 4px 0 0;">Party, Bodycon & Summer Styles</p>
      </div>
    </a>

    <a href="/collections/all?q=sweater" style="text-decoration: none; position: relative; border-radius: 20px; overflow: hidden; height: 300px; box-shadow: 0 8px 25px rgba(0,0,0,0.06); display: block;">
      <img src="https://images.unsplash.com/photo-1576566588028-4147f3842f27?auto=format&fit=crop&w=600&q=80" alt="Sweaters & Knits" style="width: 100%; height: 100%; object-fit: cover;">
      <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85), transparent 60%); padding: 24px; display: flex; flex-direction: column; justify-content: flex-end; color: #fff;">
        <span style="background: #ff3f6c; color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 0.75rem; font-weight: 800; width: fit-content; margin-bottom: 8px;">SEASONAL</span>
        <h3 style="font-size: 1.4rem; font-weight: 900; margin: 0; color: #fff;">Sweaters & Knits</h3>
        <p style="font-size: 0.85rem; color: #E2E8F0; margin: 4px 0 0;">Pullovers, Jumpers & Cardigans</p>
      </div>
    </a>

    <a href="/collections/all?q=jacket" style="text-decoration: none; position: relative; border-radius: 20px; overflow: hidden; height: 300px; box-shadow: 0 8px 25px rgba(0,0,0,0.06); display: block;">
      <img src="https://images.unsplash.com/photo-1551028719-00167b16eac5?auto=format&fit=crop&w=600&q=80" alt="Jackets & Outerwear" style="width: 100%; height: 100%; object-fit: cover;">
      <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85), transparent 60%); padding: 24px; display: flex; flex-direction: column; justify-content: flex-end; color: #fff;">
        <span style="background: #ff3f6c; color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 0.75rem; font-weight: 800; width: fit-content; margin-bottom: 8px;">OUTERWEAR</span>
        <h3 style="font-size: 1.4rem; font-weight: 900; margin: 0; color: #fff;">Jackets & Coats</h3>
        <p style="font-size: 0.85rem; color: #E2E8F0; margin: 4px 0 0;">Blazers, Suede & Motorcycle</p>
      </div>
    </a>

    <a href="/collections/all?q=suit" style="text-decoration: none; position: relative; border-radius: 20px; overflow: hidden; height: 300px; box-shadow: 0 8px 25px rgba(0,0,0,0.06); display: block;">
      <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=600&q=80" alt="Suits & Co-ords" style="width: 100%; height: 100%; object-fit: cover;">
      <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85), transparent 60%); padding: 24px; display: flex; flex-direction: column; justify-content: flex-end; color: #fff;">
        <span style="background: #ff3f6c; color: #fff; padding: 4px 12px; border-radius: 12px; font-size: 0.75rem; font-weight: 800; width: fit-content; margin-bottom: 8px;">2-PIECE SETS</span>
        <h3 style="font-size: 1.4rem; font-weight: 900; margin: 0; color: #fff;">Suits & Sets</h3>
        <p style="font-size: 0.85rem; color: #E2E8F0; margin: 4px 0 0;">Matching Pants & Skirt Outfits</p>
      </div>
    </a>
  </div>
</div>

