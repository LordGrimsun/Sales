
<div class="page-width" style="padding-top: 40px; padding-bottom: 44px;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 36px; align-items: center;">
    <div>
      <div class="sy-pill sy-pill-gold" style="margin-bottom: 14px;">🔥 AS SEEN ON TIKTOK · 45% OFF RESTOCK</div>
      <h1 style="font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.15; font-weight: 800; margin: 0 0 16px 0; letter-spacing: -0.02em;">
        Fix Your Sleep & Ditch The Morning Neck Pain <span style="color: #0D5C3A;">Forever.</span>
      </h1>
      <p style="font-size: 16px; color: #5A626A; line-height: 1.6; margin-bottom: 20px;">
        The viral ergonomic orthopedic cervical pillow scientifically engineered to cradle your head, decompress cervical vertebrae, and align your spine in any sleeping position.
      </p>

      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
        <div style="color: #E58A2B; font-size: 16px;">★★★★★</div>
        <div style="font-size: 13.5px; font-weight: 600; color: #151414;">4.9/5 from 12,800+ happy sleepers</div>
      </div>

      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 24px;">
        <span style="font-size: 32px; font-weight: 900; color: #0D5C3A;">$49.99</span>
        <span style="font-size: 18px; color: #8C96A3; text-decoration: line-through;">$89.99</span>
        <span class="sy-pill sy-pill-pink">SAVE $40 (45% OFF)</span>
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 24px;">
        <a href="/products/sunnyeora-cervical-contour-pillow" class="sy-btn-primary">
          CLAIM YOUR 45% DISCOUNT ➔
        </a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; font-size: 12px; color: #5A626A;">
        <div style="display: flex; align-items: center; gap: 6px;">🇺🇸 Free USPS Express</div>
        <div style="display: flex; align-items: center; gap: 6px;">🛡️ 30-Night Sleep Trial</div>
        <div style="display: flex; align-items: center; gap: 6px;">💳 SSL 256-Bit Checkout</div>
      </div>
    </div>

    <!-- Hero Visual Card -->
    <div class="sy-card" style="padding: 24px; text-align: center; position: relative; overflow: hidden;">
      <div style="background: linear-gradient(135deg, rgba(13,92,58,0.08), rgba(229,138,43,0.08)); border-radius: 12px; padding: 40px 20px;">
        <div style="font-size: 72px; margin-bottom: 12px;">🛏️</div>
        <h3 style="font-size: 20px; font-weight: 800; margin: 0 0 6px 0;">Sunnyeora Deep-Sleep™</h3>
        <p style="font-size: 13px; color: #5A626A; margin: 0 0 16px 0;">Orthopedic Cervical Contour Memory Foam</p>
        <div class="sy-pill sy-pill-green">✨ 5-Year Shape Retention Guarantee</div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Sunnyeora Hero",
  "settings": []
}
{% endschema %}
