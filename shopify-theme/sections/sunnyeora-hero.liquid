
<style>
  .sy-hero-container {
    max-width: 1400px;
    margin: 30px auto;
    padding: 0 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .sy-hero-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 40px;
    align-items: center;
    background: #FAF9F5;
    border-radius: 24px;
    padding: 50px 40px;
    border: 1px solid #E2E8F0;
  }
  .sy-hero-pill {
    display: inline-block;
    background: #E8F3EE;
    color: #0D5C3A;
    border: 1px solid #D1E7DD;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }
  .sy-hero-heading {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
    font-weight: 900;
    color: #1E293B;
    margin: 0 0 16px 0;
  }
  .sy-hero-heading span {
    color: #0D5C3A;
  }
  .sy-hero-text {
    font-size: 1.05rem;
    color: #64748B;
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .sy-hero-img-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0,0,0,0.08);
    aspect-ratio: 4/3;
  }
  .sy-hero-img-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sy-hero-cta-btn {
    background: #0D5C3A;
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 30px;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    display: inline-block;
    box-shadow: 0 6px 20px rgba(13,92,58,0.3);
    transition: background 0.2s, transform 0.15s;
  }
  .sy-hero-cta-btn:hover {
    background: #092B1C;
    transform: translateY(-2px);
  }
</style>

<div class="sy-hero-container">
  <div class="sy-hero-inner">
    <div>
      <div class="sy-hero-pill">🔥 AS SEEN ON TIKTOK • 45% OFF RESTOCK</div>
      <h1 class="sy-hero-heading">
        Fix Your Sleep & Ditch Morning Neck Stiffness <span>Forever.</span>
      </h1>
      <p class="sy-hero-text">
        The viral orthopedic cervical contour pillow scientifically engineered to cradle your head, decompress cervical vertebrae, and align your spine for deep, restorative sleep.
      </p>

      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
        <div style="color: #F59E0B; font-size: 1.1rem;">★★★★★</div>
        <div style="font-size: 0.95rem; font-weight: 700; color: #1E293B;">4.9/5 from 12,800+ Verified Sleepers</div>
      </div>

      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 24px;">
        <span style="font-size: 2.2rem; font-weight: 900; color: #1E293B;">$49.99</span>
        <span style="font-size: 1.2rem; color: #94A3B8; text-decoration: line-through;">$89.99</span>
        <span style="background: #FEF3C7; color: #D97706; padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.85rem;">SAVE $40 (45% OFF)</span>
      </div>

      <a href="/collections/deep-sleep" class="sy-hero-cta-btn">
        CLAIM YOUR 45% DISCOUNT ➔
      </a>

      <div style="display: flex; gap: 16px; margin-top: 24px; font-size: 0.82rem; color: #64748B; flex-wrap: wrap;">
        <div>🇺🇸 Free USPS Air Express</div>
        <div>🛡️ 30-Night Sleep Trial</div>
        <div>💳 SSL 256-Bit Checkout</div>
      </div>
    </div>

    <div class="sy-hero-img-card">
      <img src="https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?auto=format&fit=crop&w=1000&q=80" alt="Sunnyeora Deep-Sleep Pillow in Bedroom">
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sunnyeora Hero",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Sunnyeora Hero"
    }
  ]
}
{% endschema %}
