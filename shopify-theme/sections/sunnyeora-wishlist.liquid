
<div class="sunnyeora-wishlist-page page-width" style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">
  <div class="wishlist-header" style="text-align: center; margin-bottom: 40px;">
    <span style="background: rgba(13, 92, 58, 0.1); color: #0D5C3A; padding: 6px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; letter-spacing: 1px;">YOUR SAVED ITEMS</span>
    <h1 style="font-size: 2.5rem; font-weight: 900; color: #111; margin: 12px 0 8px;">My Wishlist</h1>
    <p style="color: #666; font-size: 1.05rem;">Save your favorite viral hits and add them to your bag when you're ready to checkout.</p>
  </div>

  <div id="wishlist-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
    <!-- Wishlist Items populated by JS or fallback defaults -->
    <div class="wishlist-card" style="background: #fff; border: 1px solid #eee; border-radius: 16px; padding: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s;">
      <div style="position: relative; border-radius: 12px; overflow: hidden; background: #f8f8f8; aspect-ratio: 1;">
        <img src="https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?auto=format&fit=crop&w=600&q=80" alt="Deep-Sleep Cervical Pillow" style="width: 100%; height: 100%; object-fit: cover;">
        <span style="position: absolute; top: 10px; left: 10px; background: #0D5C3A; color: #fff; padding: 4px 10px; border-radius: 12px; font-weight: 800; font-size: 0.75rem;">45% OFF</span>
      </div>
      <div style="padding: 16px 0 0;">
        <span style="font-size: 0.8rem; color: #0D5C3A; font-weight: 700; text-transform: uppercase;">Ergonomic Sleep</span>
        <h3 style="font-size: 1.1rem; font-weight: 700; margin: 6px 0; color: #111;">Deep-Sleep™ Contour Cervical Pillow</h3>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
          <span style="font-weight: 800; font-size: 1.25rem; color: #0D5C3A;">$49.99</span>
          <span style="text-decoration: line-through; color: #999; font-size: 0.95rem;">$89.99</span>
        </div>
        <button style="width: 100%; background: #0D5C3A; color: #fff; border: none; padding: 12px; border-radius: 12px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s;">
          MOVE TO BAG
        </button>
      </div>
    </div>

    <div class="wishlist-card" style="background: #fff; border: 1px solid #eee; border-radius: 16px; padding: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: transform 0.2s;">
      <div style="position: relative; border-radius: 12px; overflow: hidden; background: #f8f8f8; aspect-ratio: 1;">
        <img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=600&q=80" alt="LuminaGlow Wand" style="width: 100%; height: 100%; object-fit: cover;">
        <span style="position: absolute; top: 10px; left: 10px; background: #d946ef; color: #fff; padding: 4px 10px; border-radius: 12px; font-weight: 800; font-size: 0.75rem;">BEST SELLER</span>
      </div>
      <div style="padding: 16px 0 0;">
        <span style="font-size: 0.8rem; color: #d946ef; font-weight: 700; text-transform: uppercase;">Glass Skin Beauty</span>
        <h3 style="font-size: 1.1rem; font-weight: 700; margin: 6px 0; color: #111;">LuminaGlow™ Red Light Therapy Wand</h3>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
          <span style="font-weight: 800; font-size: 1.25rem; color: #0D5C3A;">$59.99</span>
          <span style="text-decoration: line-through; color: #999; font-size: 0.95rem;">$99.99</span>
        </div>
        <button style="width: 100%; background: #0D5C3A; color: #fff; border: none; padding: 12px; border-radius: 12px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background 0.2s;">
          MOVE TO BAG
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
