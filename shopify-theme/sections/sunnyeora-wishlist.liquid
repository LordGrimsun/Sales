
<div class="sunnyeora-wishlist-page page-width" style="max-width: 1200px; margin: 40px auto; padding: 0 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <div class="wishlist-header" style="text-align: center; margin-bottom: 40px;">
    <span style="background: rgba(13, 92, 58, 0.1); color: #0D5C3A; padding: 6px 16px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; letter-spacing: 1px;">YOUR SAVED ITEMS</span>
    <h1 style="font-size: 2.5rem; font-weight: 900; color: #111; margin: 12px 0 8px;">My Wishlist</h1>
    <p style="color: #666; font-size: 1.05rem;">Save your favorite pieces and add them to your bag when you're ready to checkout.</p>
  </div>

  <div id="wishlist-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
    <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: #fafbfc; border-radius: 16px; border: 1px dashed #e2e8f0;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8" style="margin: 0 auto 16px; display: block;">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
      <h3 style="font-size: 1.3rem; font-weight: 800; color: #1e293b; margin: 0 0 8px;">Your Wishlist is Empty</h3>
      <p style="color: #64748b; font-size: 0.95rem; margin: 0 0 24px;">Explore our store inventory and tap the heart icon to save your favorite items here.</p>
      <a href="/collections/all" style="display: inline-block; background: #0D5C3A; color: #ffffff; padding: 12px 28px; border-radius: 25px; font-weight: 800; text-decoration: none; font-size: 0.9rem; box-shadow: 0 4px 12px rgba(13,92,58,0.25);">
        EXPLORE ALL PRODUCTS
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
