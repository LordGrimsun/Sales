
<div class="page-width" id="catalog" style="padding-top: 20px; padding-bottom: 60px;">
  
  <!-- Marketplace Toolbar -->
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-bottom: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--sy-border);">
    <div>
      <h2 style="font-size: 24px; font-weight: 900; margin: 0; color: #0F172A;">Trending Viral Collection 🔥</h2>
      <span style="font-size: 13px; color: #64748B;">Showing 3 High-Demand Verified Winners</span>
    </div>
    <div style="display: flex; gap: 10px; align-items: center;">
      <span style="font-size: 12px; font-weight: 700; color: #64748B;">SORT BY:</span>
      <select style="background: #ffffff; border: 1px solid var(--sy-border); padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; outline: none; cursor: pointer;">
        <option>Popularity / Best Selling</option>
        <option>Customer Rating (High to Low)</option>
        <option>Price (Low to High)</option>
      </select>
    </div>
  </div>

  <!-- Marketplace Product Cards Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
    
    <!-- Item 1: Cervical Pillow -->
    <div class="sy-product-card">
      <span class="sy-badge-discount">-45% OFF</span>
      <button class="sy-wishlist-btn" title="Add to Wishlist">❤️</button>
      
      <div style="background: linear-gradient(135deg, #F1F5F9, #E2E8F0); height: 220px; display: flex; align-items: center; justify-content: center; font-size: 72px;">
        🛏️
      </div>

      <div style="padding: 18px; display: flex; flex-direction: column; flex: 1;">
        <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
          <span style="color: #FFB800; font-size: 14px;">★★★★★</span>
          <span style="font-size: 12px; font-weight: 700; color: #0F172A;">4.9 (2,840)</span>
          <span style="font-size: 11px; color: #64748B; margin-left: auto;">🇺🇸 USPS 2-Day Air</span>
        </div>

        <h3 style="font-size: 16px; font-weight: 800; color: #0F172A; margin: 0 0 6px 0; line-height: 1.3;">
          Sunnyeora Deep-Sleep™ Orthopedic Cervical Pillow
        </h3>
        <p style="font-size: 12.5px; color: #64748B; margin: 0 0 14px 0; line-height: 1.4;">
          Cervical traction memory foam aligns spine & eliminates neck stiffness.
        </p>

        <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 16px;">
          <span style="font-size: 22px; font-weight: 900; color: #00E676;">$49.99</span>
          <span style="font-size: 14px; color: #94A3B8; text-decoration: line-through;">$89.99</span>
          <span style="font-size: 11px; font-weight: 700; color: #FF007A; margin-left: auto;">SAVE $40</span>
        </div>

        <button class="sy-add-bag-btn sy-trigger-cart" data-title="Sunnyeora Deep-Sleep™ Cervical Pillow" data-price="49.99" data-icon="🛏️" style="margin-top: auto;">
          🛍️ ADD TO BAG
        </button>
      </div>
    </div>

    <!-- Item 2: LuminaGlow Wand -->
    <div class="sy-product-card">
      <span class="sy-badge-discount">-40% OFF</span>
      <button class="sy-wishlist-btn" title="Add to Wishlist">❤️</button>
      
      <div style="background: linear-gradient(135deg, #FDF2F8, #FCE7F3); height: 220px; display: flex; align-items: center; justify-content: center; font-size: 72px;">
        ✨
      </div>

      <div style="padding: 18px; display: flex; flex-direction: column; flex: 1;">
        <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
          <span style="color: #FFB800; font-size: 14px;">★★★★★</span>
          <span style="font-size: 12px; font-weight: 700; color: #0F172A;">4.8 (1,920)</span>
          <span style="font-size: 11px; color: #64748B; margin-left: auto;">✨ Viral Favorite</span>
        </div>

        <h3 style="font-size: 16px; font-weight: 800; color: #0F172A; margin: 0 0 6px 0; line-height: 1.3;">
          Sunnyeora LuminaGlow™ 7-in-1 Red Light Wand
        </h3>
        <p style="font-size: 12.5px; color: #64748B; margin: 0 0 14px 0; line-height: 1.4;">
          660nm red light + microcurrent for snatched jawlines & glass skin.
        </p>

        <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 16px;">
          <span style="font-size: 22px; font-weight: 900; color: #00E676;">$59.99</span>
          <span style="font-size: 14px; color: #94A3B8; text-decoration: line-through;">$99.99</span>
          <span style="font-size: 11px; font-weight: 700; color: #FF007A; margin-left: auto;">SAVE $40</span>
        </div>

        <button class="sy-add-bag-btn sy-trigger-cart" data-title="Sunnyeora LuminaGlow™ Red Light Wand" data-price="59.99" data-icon="✨" style="margin-top: auto;">
          🛍️ ADD TO BAG
        </button>
      </div>
    </div>

    <!-- Item 3: CrystalSonic Cleaner -->
    <div class="sy-product-card">
      <span class="sy-badge-discount">-43% OFF</span>
      <button class="sy-wishlist-btn" title="Add to Wishlist">❤️</button>
      
      <div style="background: linear-gradient(135deg, #F0F9FF, #E0F2FE); height: 220px; display: flex; align-items: center; justify-content: center; font-size: 72px;">
        💎
      </div>

      <div style="padding: 18px; display: flex; flex-direction: column; flex: 1;">
        <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
          <span style="color: #FFB800; font-size: 14px;">★★★★★</span>
          <span style="font-size: 12px; font-weight: 700; color: #0F172A;">4.9 (3,410)</span>
          <span style="font-size: 11px; color: #64748B; margin-left: auto;">🌊 45kHz Sonic</span>
        </div>

        <h3 style="font-size: 16px; font-weight: 800; color: #0F172A; margin: 0 0 6px 0; line-height: 1.3;">
          Sunnyeora CrystalSonic™ Ultrasonic Cleaner
        </h3>
        <p style="font-size: 12.5px; color: #64748B; margin: 0 0 14px 0; line-height: 1.4;">
          45,000Hz sound waves dislodge grime from jewelry, glasses & aligners in 180s.
        </p>

        <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 16px;">
          <span style="font-size: 22px; font-weight: 900; color: #00E676;">$39.99</span>
          <span style="font-size: 14px; color: #94A3B8; text-decoration: line-through;">$69.99</span>
          <span style="font-size: 11px; font-weight: 700; color: #FF007A; margin-left: auto;">SAVE $30</span>
        </div>

        <button class="sy-add-bag-btn sy-trigger-cart" data-title="Sunnyeora CrystalSonic™ Ultrasonic Cleaner" data-price="39.99" data-icon="💎" style="margin-top: auto;">
          🛍️ ADD TO BAG
        </button>
      </div>
    </div>

  </div>
</div>
{% schema %}
{
  "name": "Marketplace Grid Catalog",
  "settings": []
}
{% endschema %}
