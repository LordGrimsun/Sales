
<style>
  .sunnyeora-bubbles-container {
    width: 100%;
    background: #FAF9F5;
    padding: 24px 0 20px;
    border-bottom: 1px solid #E2E8F0;
  }
  .sunnyeora-bubbles-scroll {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    justify-content: flex-start;
  }
  @media (min-width: 768px) {
    .sunnyeora-bubbles-scroll {
      justify-content: center;
    }
  }
  .sunnyeora-bubbles-scroll::-webkit-scrollbar {
    display: none;
  }
  .sunnyeora-bubble-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none !important;
    min-width: 86px;
    cursor: pointer;
    transition: transform 0.25s ease;
  }
  .sunnyeora-bubble-card:hover {
    transform: translateY(-4px);
  }
  .sunnyeora-bubble-ring {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, #0D5C3A 0%, #34D399 50%, #D97706 100%);
    box-shadow: 0 4px 14px rgba(13, 92, 58, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .sunnyeora-bubble-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #FFFFFF;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sunnyeora-bubble-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .sunnyeora-bubble-card:hover .sunnyeora-bubble-inner img {
    transform: scale(1.12);
  }
  .sunnyeora-bubble-text {
    margin-top: 10px;
    font-size: 0.8rem;
    font-weight: 800;
    color: #1E293B !important;
    text-decoration: none !important;
    white-space: nowrap;
    letter-spacing: 0.2px;
  }
  .sunnyeora-bubble-card:hover .sunnyeora-bubble-text {
    color: #0D5C3A !important;
  }
</style>

