    </div>

    <!-- Myntra Subtle Dots Indicator -->
    <div class="myntra-dots-container" id="myntraDotsContainer">
      <button class="myntra-dot active" data-index="0" aria-label="Slide 1"></button>
      <button class="myntra-dot" data-index="1" aria-label="Slide 2"></button>
      <button class="myntra-dot" data-index="2" aria-label="Slide 3"></button>
      <button class="myntra-dot" data-index="3" aria-label="Slide 4"></button>
    </div>

  </div>
</div>

<script>
  (function() {
    var track = document.getElementById('myntraCarouselTrack');
    var viewport = document.getElementById('myntraCarouselViewport');
    var dots = document.querySelectorAll('#myntraDotsContainer .myntra-dot');
    if (!track || !viewport) return;

    var currentIndex = 0;
    var totalSlides = 4;
    var slideInterval = null;
    var touchStartX = 0;
    var touchEndX = 0;

    function goToSlide(index) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';

      dots.forEach(function(dot, i) {
        if (i === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    function startAutoSlide() {
      clearInterval(slideInterval);
      slideInterval = setInterval(function() {
        goToSlide(currentIndex + 1);
      }, 4200);
    }

    function stopAutoSlide() {
      clearInterval(slideInterval);
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function(e) {
        e.stopPropagation();
        var idx = parseInt(this.getAttribute('data-index'), 10);
        goToSlide(idx);
        startAutoSlide();
      });
    });

    viewport.addEventListener('mouseenter', stopAutoSlide);
    viewport.addEventListener('mouseleave', startAutoSlide);

    viewport.addEventListener('touchstart', function(e) {
      stopAutoSlide();
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    viewport.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      startAutoSlide();
      var diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          goToSlide(currentIndex + 1);
        } else {
          goToSlide(currentIndex - 1);
        }
      }
    }, { passive: true });

    startAutoSlide();
  })();
</script>

