    // Check if path matches a known product handle or contains product query
    let matchedHandle = null;
    if (pathName.includes('pillow') || pathName.includes('cervical') || pathName.includes('deep-sleep')) {
      matchedHandle = 'deep-sleep-cervical-pillow';
    } else if (pathName.includes('wand') || pathName.includes('red-light') || pathName.includes('luminaglow')) {
      matchedHandle = 'luminaglow-red-light-wand';
    } else if (pathName.includes('cleaner') || pathName.includes('sonic') || pathName.includes('ultrasonic')) {
      matchedHandle = 'crystal-sonic-cleaner';
    } else if (pathName.startsWith('/products/')) {
      // Default fallback product if general /products/ route
      matchedHandle = 'deep-sleep-cervical-pillow';
    }

    if (matchedHandle && CATALOG[matchedHandle]) {
      const prod = CATALOG[matchedHandle];
      document.getElementById('syFallback404').style.display = 'none';
      document.getElementById('syPdpWrap').style.display = 'block';
      document.title = prod.title + ' | Sunnyeora';

      // Populate PDP
      document.getElementById('pdpBreadcrumbCategory').textContent = prod.category;
      document.getElementById('pdpBreadcrumbTitle').textContent = prod.title;
      document.getElementById('pdpBrandTag').textContent = prod.brand;
      document.getElementById('pdpTitle').textContent = prod.title;
      document.getElementById('pdpPriceNow').textContent = '$' + prod.price;
      document.getElementById('pdpPriceWas').textContent = '$' + prod.wasPrice;
      document.getElementById('pdpDiscountTag').textContent = prod.discount;
      document.getElementById('pdpRatingText').textContent = prod.rating;
      document.getElementById('pdpSoldCount').textContent = '🔥 ' + prod.sold;
      document.getElementById('pdpStockLeft').textContent = prod.stock;
      document.getElementById('pdpSelectedSize').textContent = prod.size;
      document.getElementById('pdpSelectedColor').textContent = prod.colors[0];

      // Gallery
      const mainImg = document.getElementById('pdpMainImg');
      mainImg.src = prod.images[0];
      const thumbsBox = document.getElementById('pdpThumbsContainer');
      thumbsBox.innerHTML = '';
      prod.images.forEach((imgUrl, idx) => {
        const thumb = document.createElement('img');
        thumb.className = 'sy-pdp-thumb' + (idx === 0 ? ' active' : '');
        thumb.src = imgUrl;
        thumb.alt = prod.title;
        thumb.onclick = function() {
          mainImg.src = imgUrl;
          document.querySelectorAll('.sy-pdp-thumb').forEach(t => t.classList.remove('active'));
          thumb.classList.add('active');
        };
        thumbsBox.appendChild(thumb);
      });

      // Swatches
      const swatchesBox = document.getElementById('pdpColorSwatches');
      swatchesBox.innerHTML = '';
      prod.colors.forEach((col, idx) => {
        const btn = document.createElement('button');
        btn.className = 'sy-swatch-btn' + (idx === 0 ? ' active' : '');
        btn.textContent = col;
        btn.onclick = function() {
          document.querySelectorAll('.sy-swatch-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          document.getElementById('pdpSelectedColor').textContent = col;
        };
        swatchesBox.appendChild(btn);
      });

      // Tabs
      document.getElementById('pdpTabOverview').innerHTML = prod.overview;
      document.getElementById('pdpTabSpecs').innerHTML = prod.specs;

      // Add to Bag Button
      document.getElementById('pdpAddBagBtn').onclick = function() {
        const color = document.getElementById('pdpSelectedColor').textContent;
        const fullTitle = prod.title + ' (' + color + ')';
        if (window.openCartDrawer) {
          window.openCartDrawer(fullTitle, prod.price, prod.images[0]);
        }
      };

      // Proceed to Checkout Button
      document.getElementById('pdpBuyNowBtn').onclick = function() {
        const color = document.getElementById('pdpSelectedColor').textContent;
        const fullTitle = prod.title + ' (' + color + ')';
        if (window.openCartDrawer) {
          window.openCartDrawer(fullTitle, prod.price, prod.images[0]);
        }
        window.location.href = '/checkout';
      };
    } else if (pathName.includes('/collections/')) {
      // If collection not found in shopify, redirect to /collections/all smoothly
      window.location.replace('/collections/all');
    }
  })();

  let pdpQty = 1;
  window.changePdpQty = function(d) {
    pdpQty += d;
    if (pdpQty < 1) pdpQty = 1;
    document.getElementById('pdpQtyVal').textContent = pdpQty;
  };

  window.switchPdpTab = function(idx) {
    document.querySelectorAll('.sy-pdp-tab-btn').forEach((b, i) => {
      b.classList.toggle('active', i === idx);
    });
    const panes = [
      document.getElementById('pdpTabOverview'),
      document.getElementById('pdpTabSpecs'),
      document.getElementById('pdpTabShipping')
    ];
    panes.forEach((p, i) => {
      if (p) p.classList.toggle('active', i === idx);
    });
  };
</script>

