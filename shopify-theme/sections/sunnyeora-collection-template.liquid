{% paginate collection.products by 48 %}
<style>
  .sunnyeora-collection-page {
    max-width: 1440px;
    margin: 30px auto 60px;
    padding: 0 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #282c3f;
  }

  .sy-col-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #8c96a3;
    margin-bottom: 20px;
  }
  .sy-col-breadcrumbs a {
    color: #696e79;
    text-decoration: none;
    font-weight: 500;
  }
  .sy-col-breadcrumbs a:hover {
    color: #ff3f6c;
  }

  .sunnyeora-collection-header {
    text-align: center;
    margin-bottom: 32px;
  }
  .sunnyeora-badge-pill {
    display: inline-block;
    background: #E8F3EE;
    color: #0D5C3A;
    padding: 6px 18px;
    border-radius: 20px;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .sunnyeora-collection-title {
    font-size: 2.3rem;
    font-weight: 900;
    color: #1E293B;
    margin: 0 0 10px;
    letter-spacing: -0.5px;
  }
  .sunnyeora-collection-subtitle {
    color: #64748B;
    font-size: 1.05rem;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Filter category pills based on real merchandise */
  .sy-category-pills {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 24px 0 20px;
    flex-wrap: wrap;
  }
  .sy-cat-pill {
    padding: 8px 20px;
    border-radius: 25px;
    background: #f5f5f6;
    border: 1.5px solid transparent;
    color: #282c3f;
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
  }
  .sy-cat-pill:hover, .sy-cat-pill.active {
    background: #ff3f6c;
    color: #ffffff;
    border-color: #ff3f6c;
    box-shadow: 0 4px 10px rgba(255, 63, 108, 0.25);
  }

  /* Controls Bar */
  .sy-controls-bar {
    background: #ffffff;
    border: 1px solid #eaeaec;
    border-radius: 12px;
    padding: 14px 20px;
    margin-bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }
  .sy-search-box {
    position: relative;
    flex: 1;
    min-width: 260px;
    max-width: 440px;
  }
  .sy-search-box input {
    width: 100%;
    height: 40px;
    padding: 0 36px 0 38px;
    border-radius: 8px;
    border: 1px solid #d4d5d9;
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s;
    background: #fbfbfb;
  }
  .sy-search-box input:focus {
    border-color: #ff3f6c;
    background: #ffffff;
  }
  .sy-search-icon-left {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .sy-summary-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    font-size: 0.9rem;
    color: #696e79;
  }
  .sy-summary-count strong {
    color: #1e293b;
    font-weight: 800;
  }

  /* Product Grid */
  .sy-catalog-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  @media (max-width: 1100px) {
    .sy-catalog-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
  }
  @media (max-width: 768px) {
    .sy-catalog-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    .sunnyeora-collection-title {
      font-size: 1.75rem;
    }
  }

  /* Product Card */
  .myntra-product-card {
    position: relative;
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #eaeaec;
    transition: transform 0.25s, box-shadow 0.25s;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .myntra-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.08);
  }
  .sy-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    flex: 1;
  }
  .myntra-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: #f7f7f8;
    overflow: hidden;
  }
  .myntra-card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .myntra-product-card:hover .myntra-card-image-wrap img {
    transform: scale(1.04);
  }
  .myntra-wishlist-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    transition: transform 0.2s, background 0.2s;
    z-index: 2;
  }
  .myntra-wishlist-btn:hover {
    transform: scale(1.12);
    background: #ffffff;
  }
  .myntra-card-details {
    padding: 12px 14px 10px;
  }
  .myntra-brand-name {
    font-size: 0.8rem;
    font-weight: 800;
    color: #282c3f;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .myntra-product-title {
    font-size: 0.86rem;
    color: #535766;
    margin: 4px 0 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.35;
    height: 2.7em;
  }
  .myntra-price-row {
    display: flex;
    align-items: baseline;
    gap: 7px;
    flex-wrap: wrap;
  }
  .myntra-current-price {
    font-size: 1.05rem;
    font-weight: 800;
    color: #282c3f;
  }
  .myntra-mrp-price {
    font-size: 0.82rem;
    color: #94969f;
    text-decoration: line-through;
  }
  .myntra-discount-tag {
    font-size: 0.78rem;
    font-weight: 800;
    color: #ff905a;
  }
  .sy-card-action-bar {
    padding: 0 14px 14px 14px;
  }
  .myntra-add-bag-btn {
    width: 100%;
    padding: 10px 0;
    background: #ffffff;
    border: 1.5px solid #282c3f;
    color: #282c3f;
    font-weight: 800;
    font-size: 0.82rem;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    letter-spacing: 0.4px;
    transition: all 0.2s;
  }
  .myntra-add-bag-btn:hover {
    background: #ff3f6c;
    border-color: #ff3f6c;
    color: #ffffff;
  }

  .sy-pagination-container {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }
  .sy-pagination-container .pagination {
    display: flex;
    gap: 8px;
    list-style: none;
    padding: 0;
  }
  .sy-pagination-container a, .sy-pagination-container span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    border-radius: 8px;
    border: 1px solid #d4d5d9;
    background: #ffffff;
    color: #282c3f;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
  }
  .sy-pagination-container .current {
    background: #ff3f6c;
    border-color: #ff3f6c;
    color: #ffffff;
  }

  .sy-empty-catalog {
    text-align: center;
    padding: 60px 20px;
    background: #fbfbfb;
    border-radius: 12px;
    border: 1px dashed #d4d5d9;
    grid-column: 1 / -1;
  }
  .sy-empty-catalog h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #1e293b;
    margin: 16px 0 8px;
  }
  .sy-empty-catalog p {
    color: #64748b;
    font-size: 0.95rem;
  }
</style>

<div class="sunnyeora-collection-page">
  <!-- Breadcrumbs -->
  <div class="sy-col-breadcrumbs">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/collections/all">Collections</a>
    <span>/</span>
    <span style="color: #1e293b; font-weight: 700;">{{ collection.title | default: 'All Products' }}</span>
  </div>

  <!-- Header -->
  <div class="sunnyeora-collection-header">
    <span class="sunnyeora-badge-pill">SUNNYEORA STORE COLLECTION</span>
    <h1 class="sunnyeora-collection-title">{{ collection.title | default: 'Authentic Collection' }}</h1>
    <p class="sunnyeora-collection-subtitle">
      Explore our verified store inventory with premium craftsmanship and reliable doorstep delivery.
    </p>

    <!-- Quick filter pills for real product categories -->
    <div class="sy-category-pills">
      <button class="sy-cat-pill active" onclick="filterByKeyword('', this)">All Items ({{ collection.all_products_count | default: collection.products.size }})</button>
      <button class="sy-cat-pill" onclick="filterByKeyword('dress', this)">Dresses & Gowns</button>
      <button class="sy-cat-pill" onclick="filterByKeyword('sweater', this)">Sweaters & Knits</button>
      <button class="sy-cat-pill" onclick="filterByKeyword('jacket', this)">Jackets & Coats</button>
      <button class="sy-cat-pill" onclick="filterByKeyword('suit', this)">Suits & Sets</button>
      <button class="sy-cat-pill" onclick="filterByKeyword('top', this)">Tops & Shirts</button>
      <button class="sy-cat-pill" onclick="filterByKeyword('skin', this)">Beauty & Skincare</button>
    </div>
  </div>

  <!-- Search & Filter Controls Bar -->
  <div class="sy-controls-bar">
    <div class="sy-search-box">
      <svg class="sy-search-icon-left" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#696e79" stroke-width="2.2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="storeSearchInput" placeholder="Filter current items by name..." oninput="handleFilterInput(this.value)">
    </div>

    <div style="font-size: 0.88rem; font-weight: 700; color: #64748b;">
      <span id="visibleCount">{{ collection.products.size }}</span> of {{ collection.all_products_count | default: collection.products.size }} products
    </div>
  </div>

  <!-- Real Products Grid -->
  <div class="sy-catalog-grid" id="realProductsGrid">
    {% for product in collection.products %}
      {% assign p_title_lower = product.title | downcase %}
      <div class="myntra-product-card" data-title="{{ p_title_lower | escape }}" data-vendor="{{ product.vendor | downcase | escape }}" data-handle="{{ product.handle }}">
        <a href="{{ product.url }}" class="sy-card-link">
          <div class="myntra-card-image-wrap">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
            {% else %}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #f1f5f9; color: #94a3b8;">No Image</div>
            {% endif %}
            <button class="myntra-wishlist-btn" onclick="event.preventDefault(); event.stopPropagation(); window.toggleWishlist && window.toggleWishlist('{{ product.handle }}', this);" aria-label="Save to Wishlist">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#282c3f" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
          </div>
          <div class="myntra-card-details">
            <div class="myntra-brand-name">{{ product.vendor | default: 'SUNNYEORA' }}</div>
            <div class="myntra-product-title" title="{{ product.title | escape }}">{{ product.title }}</div>
            <div class="myntra-price-row">
              <span class="myntra-current-price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="myntra-mrp-price">{{ product.compare_at_price | money }}</span>
                {% assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                <span class="myntra-discount-tag">({{ discount_pct }}% OFF)</span>
              {% endif %}
            </div>
          </div>
        </a>
        <div class="sy-card-action-bar">
          <button class="myntra-add-bag-btn" onclick="event.preventDefault(); if(window.openCartDrawer) { window.openCartDrawer('{{ product.title | escape }}', '{{ product.price | money_without_currency }}', '{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 }}{% endif %}'); }">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            ADD TO BAG
          </button>
        </div>
      </div>
    {% else %}
      <div class="sy-empty-catalog">
        <h3>No products in this collection</h3>
        <p>Browse our catalog or check back soon for new arrivals.</p>
      </div>
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    <div class="sy-pagination-container">
      {{ paginate | default_pagination }}
    </div>
  {% endif %}
</div>

<script>
  let activeKeyword = '';
  let activeSearchTerm = '';

  window.filterByKeyword = function(kw, btn) {
    activeKeyword = kw.toLowerCase();
    document.querySelectorAll('.sy-cat-pill').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    applyCardFilters();
  };

  window.handleFilterInput = function(val) {
    activeSearchTerm = val.toLowerCase().trim();
    applyCardFilters();
  };

  function applyCardFilters() {
    let visible = 0;
    const cards = document.querySelectorAll('#realProductsGrid .myntra-product-card');
    cards.forEach(card => {
      const title = card.dataset.title || '';
      const vendor = card.dataset.vendor || '';
      const kwMatch = !activeKeyword || title.includes(activeKeyword) || vendor.includes(activeKeyword);
      const searchMatch = !activeSearchTerm || title.includes(activeSearchTerm) || vendor.includes(activeSearchTerm);

      if (kwMatch && searchMatch) {
        card.style.display = 'flex';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    const countEl = document.getElementById('visibleCount');
    if (countEl) countEl.textContent = visible;
  }

  // Check URL query on load
  document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      const input = document.getElementById('storeSearchInput');
      if (input) input.value = q;
      activeSearchTerm = q.toLowerCase().trim();
      applyCardFilters();
    }
  });
</script>

{% schema %}
{
  "name": "Collection Template",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Collection Template"
    }
  ]
}
{% endschema %}
{% endpaginate %}
