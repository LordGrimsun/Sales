{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/tasks/:id/:action", "destination": "/api/tasks/[...path]?id=:id&action=:action" },
    { "source": "/api/routines/:routineId", "destination": "/api/routines/[...path]?routineId=:routineId" },
    { "source": "/dark", "destination": "/dark.html" },
    { "source": "/command-centre-v2.html", "destination": "/command-centre-v2.html" }
  ]
}
